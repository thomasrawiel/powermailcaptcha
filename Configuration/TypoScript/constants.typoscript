plugin.tx_powermailcaptcha {
    # cat=powermailcaptcha//0001; type=boolean; label= Enable Captcha Frontend Rendering
    enable = 1

    # cat=powermailcaptcha//0010; type=text; label= Captcha Sitekey
    sitekey = abcdef

    # cat=powermailcaptcha//0020; type=text; label= Captcha Secret Key
    secretkey = abcdef

    # cat=powermailcaptcha//0030; type=options [Google Recaptcha V2 (Checkbox)=recaptcha,Google Recaptcha V3=recaptcha3,Friendly Captcha V1=friendlycaptcha,Friendly Captcha V2=friendlycaptcha2,hCaptcha=hcaptcha,Cloudflare Turnstile=cloudflare,Prosopo Procaptcha=procaptcha]; label= Captcha type
    captchaMethod = recaptcha

    # cat=powermailcaptcha//0040; type=boolean; label= Force website language instead of browser language
    useSiteLanguage = 1

    # cat=powermailcaptcha//0050; type=options [Default=default,EU=eu]; label= Verify Url Endpoint (friendlycaptcha only)
    endpoint = default

    # cat=powermailcaptcha//0060; type=number; label= Recaptcha v3 Minimum score (0-1): https://developers.google.com/recaptcha/docs/v3#interpreting_the_score
    minScore = 0.8

    # cat=powermailcaptcha//0070; type=string; label= Recaptcha v3 Expected action: https://developers.google.com/recaptcha/docs/v3#actions
    action = powermail_form_submit
}
